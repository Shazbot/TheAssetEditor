<material>
 <name>emp_empire_knights_head_01_weighted2.xml</name>
  <shader>shaders/weighted2_random_colours.xml.shader</shader>
  <sort_override>255</sort_override>
  <textures>
    <texture>
   <slot version="2">t_xml_blood_map</slot>
   <source>commontextures/bloodmap.dds</source>
    </texture>
    <texture>
   <slot version="2">t_xml_colour_map</slot>
      <source>VariantMeshes/wh_variantmodels/hr1/vmp/vmp_skeletal_horse/tex/AK_ducale_array_colours_diffuse.dds</source>
    </texture>
    <texture>
   <slot version="2">t_xml_colour_map_2</slot>
      <source>VariantMeshes/wh_variantmodels/hr1/vmp/vmp_skeletal_horse/tex/AK_ducale_array_colours_diffuse.dds</source>
    </texture>

  <texture>
   <slot version="2">t_xml_base_colour</slot>
    <source>VariantMeshes/wh_variantmodels/hu1/emp/emp_empire_knights/tex/ak_teb_knight_head_nolaurel2_base.dds</source>
    </texture>
    <texture>
   <slot version="2">t_xml_mask1</slot>
   <source>VariantMeshes/wh_variantmodels/hu1/emp/emp_empire_knights/tex/emp_empire_knights_head_01_mask.dds</source>
  </texture>
  <texture>
   <slot version="2">t_xml_material_map</slot>
   <source>VariantMeshes/wh_variantmodels/hu1/emp/emp_empire_knights/tex/emp_empire_knights_head_01_material_map.dds</source>
  </texture>
  <texture>
   <slot version="2">t_xml_normal</slot>
   <source>VariantMeshes/wh_variantmodels/hu1/emp/emp_knights_reiksguard/tex/emp_reiksguard_head_01_normal.dds</source>
    </texture>
  <texture>
   <slot version="2">t_xml_distortion_noise</slot>
   <source>commontextures/winds_of_magic_noise.dds</source>
  </texture>
  <texture>
   <slot version="2">t_xml_distortion</slot>
   <source>commontextures/winds_of_magic_specular.dds</source>
  </texture>
  <texture>
   <slot version="2">t_xml_dither</slot>
   <source>commontextures/dither.dds</source>
  </texture>
  </textures>
  <params>
  <param>
   <name>blood_uv_scale</name>
   <type>float2</type>
   <value>1,1</value>
  </param>
  <param>
   <name>num_columns</name>
   <type>float</type>
   <value>16</value>
  </param>
  <param>
   <name>receives_blood</name>
   <type>float</type>
   <value>1</value>
  </param>
 </params>
</material>