<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measures BCnEncoder.Net against DirectXTexNet on the inputs captured from a real optimizer run
       (PACK_OPTIMIZER_DDS_CAPTURE_DIR). Measurement only; nothing here feeds the optimizer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Editors\ImportExportEditor\Editors.ImportExport.Dds\Editors.ImportExport.Dds.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <!-- The library the native shim replaces; kept here as the reference for the parity run and the measurements. -->
    <PackageReference Include="DirectXTexNet" Version="1.0.7" />
  </ItemGroup>
</Project>
