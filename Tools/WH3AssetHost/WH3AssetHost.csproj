<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.6.0</Version>
    <!-- The optimizer allocates ~80 GB of short-lived objects per large pack; server GC cut a TEB run
         from 166 s to 120 s (GC pauses 42 s -> 8 s) for about 0.7 GB more peak working set. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <!-- The informational version is "<Version>+<git commit>" (the SDK appends SourceRevisionId); the
       commit is "unknown" when git is not available. whmm keys its optimized-mod cache on it. -->
  <Target Name="StampGitCommit" BeforeTargets="InitializeSourceControlInformation;AddSourceRevisionToInformationalVersion;GetAssemblyAttributes">
    <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="WhmmGitCommit" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == '' And '$(WhmmGitCommit)' != ''">$(WhmmGitCommit)</SourceRevisionId>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Release builds are distributed with the mod manager as one self-contained file. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- IL2104 is the linker summary emitted by non-trim-aware package assemblies that
         remain copied intact in partial mode. Keep the underlying diagnostics visible while
         retaining strict treatment for direct trim-analysis warnings in application code. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>

    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableDiagnostics>false</EnableDiagnostics>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Editors\ImportExportEditor\Editors.ImportExport.Core\Editors.ImportExport.Core.csproj" />
    <ProjectReference Include="..\..\Editors\PackOptimizer\Editors.PackOptimizer.Core\Editors.PackOptimizer.Core.csproj" />
    <ProjectReference Include="..\..\GameWorld\GameWorldCore\GameWorld.AssetCore\GameWorld.AssetCore.csproj" />
    <ProjectReference Include="..\..\Shared\PackFiles\Shared.PackFiles.Core\Shared.PackFiles.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Trim/WH3AssetHost.Linker.xml" />
  </ItemGroup>

</Project>
