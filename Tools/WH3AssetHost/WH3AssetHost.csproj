<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Release builds are distributed with the mod manager as one self-contained file. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- IL2104 is the linker summary emitted by non-trim-aware package assemblies that
         remain copied intact in partial mode. Keep the underlying diagnostics visible while
         retaining strict treatment for direct trim-analysis warnings in application code. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>

    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableDiagnostics>false</EnableDiagnostics>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <!-- The pack optimizer needs DirectXTexNet, a C++/CLI (IJW) assembly. IJW cannot run from a single-file
       bundle (the native image is extracted but the runtime cannot be hosted for it) and it breaks under
       trimming (the trimmer cannot see what DirectXTexNetImpl.dll calls; the runtime also turns C++/CLI
       host activation off in trimmed apps). `optimize` therefore needs the folder layout:
         dotnet publish -c Release -p:WH3AssetHostFolderLayout=true
       This is still self-contained and ReadyToRun, but not single-file and not trimmed. The default
       Release publish stays single-file and trimmed for `serve`; `optimize` reports that it is unavailable there. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(WH3AssetHostFolderLayout)' == 'true'">
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCppCLIHostActivation>true</EnableCppCLIHostActivation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Editors\ImportExportEditor\Editors.ImportExport.Core\Editors.ImportExport.Core.csproj" />
    <ProjectReference Include="..\..\Editors\PackOptimizer\Editors.PackOptimizer.Core\Editors.PackOptimizer.Core.csproj" />
    <ProjectReference Include="..\..\GameWorld\GameWorldCore\GameWorld.AssetCore\GameWorld.AssetCore.csproj" />
    <ProjectReference Include="..\..\Shared\PackFiles\Shared.PackFiles.Core\Shared.PackFiles.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Trim/WH3AssetHost.Linker.xml" />
  </ItemGroup>

</Project>
