<windowhandling:AssetEditorWindow
    x:Class="Editors.KitbasherEditor.Services.TextureAtlasProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowhandling="clr-namespace:WindowHandling;assembly=Shared.Ui"
    Title="Texture Atlas Pack"
    Width="680"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Closing="Window_OnClosing"
    Style="{StaticResource CustomWindowStyle}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="15"
            FontWeight="SemiBold"
            Text="Create Texture Atlas Pack" />

        <CheckBox
            x:Name="BuildAtlasesCheckBox"
            Grid.Row="1"
            Margin="0,12,0,0"
            Content="Build texture atlases (experimental)"
            IsChecked="False"
            Checked="BuildAtlasesCheckBox_OnChanged"
            Unchecked="BuildAtlasesCheckBox_OnChanged" />

        <TextBlock
            Grid.Row="2"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Off by default. Atlasing adds large generated textures (about 150-190 MiB per pack on the reference packs) for a small measured gain (about 2 % fewer soldier-part instances). When off, the tool only merges parts that already share a material and optimizes geometry."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="MergeMeshesCheckBox"
            Grid.Row="3"
            Margin="0,12,0,0"
            Content="Merge compatible mesh parts (experimental, improves draw calls)"
            IsChecked="True" />

        <TextBlock
            Grid.Row="4"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="When enabled, compatible parts within the same rigid and LOD may be combined. This changes mesh part indices; WSModel material indices are rewritten automatically."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="ShareAcrossVmdsCheckBox"
            Grid.Row="5"
            Margin="0,12,0,0"
            Content="Share atlases and generated materials across VMDs"
            IsChecked="True" />

        <TextBlock
            Grid.Row="6"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="When enabled, compatible mesh parts from the selected atlas VMD population are planned together so they can share atlas placements, atlas textures, and generated materials."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="AtlasAllVmdsCheckBox"
            Grid.Row="7"
            Margin="0,12,0,0"
            Content="Atlas all VMDs in the pack (include non-gameplay visuals)"
            IsChecked="False" />

        <TextBlock
            Grid.Row="8"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Off by default: only VMDs reachable from gameplay units, battle agent visuals, mounts, engines, and child VMD references are atlased. Dependency scanning and safe cleanup still inspect the full pack."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="ScoreAllGameUnitsCheckBox"
            Grid.Row="9"
            Margin="0,12,0,0"
            Content="Score atlas value across all game cultures (conservative)"
            IsChecked="False" />

        <TextBlock
            Grid.Row="10"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Off by default: the player side is scored from cultures affected by this pack, while the opponent side is sampled uniformly from all resolved game cultures. Unrelated cultures contribute nothing for culture-local assets; same-culture mirrors and proven shared assets are accounted for automatically. Enable this to score the player side across all game cultures too."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="OptimizeGeometryCheckBox"
            Grid.Row="11"
            Margin="0,12,0,0"
            Content="Optimize geometry (experimental)"
            IsChecked="True" />

        <TextBlock
            Grid.Row="12"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="When enabled, atlased or merged rigid meshes remove unused vertices and degenerate triangles, deduplicate identical vertices, optimize triangle order for the GPU vertex cache, and reorder the vertex buffer for locality."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="CrossRigidMergesCheckBox"
            Grid.Row="13"
            Margin="0,12,0,0"
            Content="Cross-rigid merges (experimental)"
            IsChecked="False"
            Checked="CrossRigidMergesCheckBox_OnChanged"
            Unchecked="CrossRigidMergesCheckBox_OnChanged" />

        <TextBlock
            Grid.Row="14"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Off by default. Merges rigids that render together into generated models and rewrites variant mesh definitions to use them. Measured benefit is small (about 0.2 % FPS on the reference pack) for tens of MiB of generated geometry and many generated VMD files."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="CrossRigidOnlyCheckBox"
            Grid.Row="15"
            Margin="0,12,0,0"
            Content="Cross-rigid joining only (fast testing)"
            IsChecked="False"
            Checked="CrossRigidOnlyCheckBox_OnChanged"
            Unchecked="CrossRigidOnlyCheckBox_OnChanged" />

        <TextBlock
            Grid.Row="16"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Runs cross-rigid analysis and emission against the original pack state. Skips texture atlasing, same-rigid mesh merging, geometry optimization, BCn residency scans, and pruning. Gameplay VMD scope and scenario scoring options still apply; results can differ from a full run because atlasing may create additional merge compatibility."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="DownscaleTexturesCheckBox"
            Grid.Row="17"
            Margin="0,12,0,0"
            Content="Downscale oversized textures (experimental)"
            IsChecked="False" />

        <TextBlock
            Grid.Row="18"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Off by default. Rewrites textures owned by this pack whose resolution is at least twice what every mesh using them needs. Same path and format, smaller size, so video memory drops; texture files are changed. Works with or without atlasing: with atlasing on, only textures the atlases did not replace are rewritten (atlas textures are never touched). Disabled in cross-rigid-only mode. The report lists every candidate whether or not this is ticked."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="SharedTextureRepackCheckBox"
            Grid.Row="19"
            Margin="0,12,0,0"
            Content="Repack shared textures (experimental)"
            IsChecked="False" />

        <TextBlock
            Grid.Row="20"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Off by default. For textures that one mod-owned rigid uses only in small regions, writes new smaller textures holding just those regions at the same texel density, rewrites that rigid's UVs, writes new materials and repoints its WSModels; the original files are not edited. Video memory only. Not available together with texture atlasing or cross-rigid merges (they rewrite UVs too). The report lists every candidate and why it was or was not built."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <CheckBox
            x:Name="CompactTexturesCheckBox"
            Grid.Row="21"
            Margin="0,12,0,0"
            Content="Compact textures exactly (experimental)"
            IsChecked="False" />

        <TextBlock
            Grid.Row="22"
            Margin="22,4,0,0"
            MaxWidth="620"
            Text="Off by default. Lossless, run last: a texture of this pack that is one flat colour in every texel of every mip level shrinks to 4x4, and a BC2/BC3 texture that is fully opaque at every level becomes BC1 (half the bytes). Every result is decoded and compared texel for texel before it is written; anything referenced outside a material (UI, VMD, text), unreferenced, or written by another stage is left alone. Same path and sRGB-ness. Disabled in cross-rigid-only mode."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <TextBlock
            x:Name="PhaseText"
            Grid.Row="23"
            Margin="0,16,0,0"
            FontWeight="SemiBold"
            Text="Ready" />

        <TextBlock
            x:Name="ItemText"
            Grid.Row="24"
            Margin="0,8,0,0"
            MinHeight="36"
            MaxWidth="640"
            TextWrapping="Wrap"
            TextTrimming="CharacterEllipsis"
            Opacity="0.8" />

        <ProgressBar
            x:Name="ProgressBar"
            Grid.Row="25"
            Height="20"
            Margin="0,12,0,0"
            Minimum="0"
            Maximum="100"
            IsIndeterminate="False"
            Value="0" />

        <Grid Grid.Row="26" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="CountText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Opacity="0.75" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="StartButton"
                    Width="100"
                    Margin="0,6,8,0"
                    Click="StartButton_Click"
                    Content="Start" />
                <Button
                    x:Name="CancelButton"
                    Width="100"
                    Margin="0,6,0,0"
                    Click="CancelButton_Click"
                    Content="Cancel" />
            </StackPanel>
        </Grid>
    </Grid>
</windowhandling:AssetEditorWindow>
