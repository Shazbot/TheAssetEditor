<Project Sdk="Microsoft.NET.Sdk">

  <!-- DDS compression and texture atlas building blocks. They call the native DirectXTexShim
       (Windows x64, P/Invoke), so they live apart from Editors.ImportExport.Core, which the
       asset host references and which stays managed-only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\PackFiles\Shared.PackFiles.Core\Shared.PackFiles.Core.csproj" />
    <ProjectReference Include="..\..\..\Shared\GameFiles\Shared.GameFormats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.1" />
  </ItemGroup>


  <!-- The prebuilt native DirectXTex shim (Native/DirectXTexShim; rebuild with its build.ps1). It is committed so
       .NET builds need no C++ toolchain. It lands next to every consuming executable and test assembly. -->
  <ItemGroup>
    <None Include="..\..\..\Native\DirectXTexShim\bin\win-x64\DirectXTexShim.dll" Link="DirectXTexShim.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
