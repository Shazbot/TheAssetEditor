<Project Sdk="Microsoft.NET.Sdk">

  <!-- DDS compression and texture atlas building blocks. These need the native DirectXTexNet
       (Windows x64), so they live apart from Editors.ImportExport.Core, which the asset host
       references and which stays managed-only (the host encodes with BCnEncoder.Net). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\PackFiles\Shared.PackFiles.Core\Shared.PackFiles.Core.csproj" />
    <ProjectReference Include="..\..\..\Shared\GameFiles\Shared.GameFormats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DirectXTexNet" Version="1.0.7" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.1" />
  </ItemGroup>

</Project>
